{
  "name": "perplexport",
  "version": "1.1.0",
  "description": "Export Perplexity conversations as markdown files",
  "main": "dist/index.js",
  "bin": {
    "perplexport": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/",
    "start": "ts-node src/index.ts",
    "dev": "ts-node-dev --respawn src/index.ts",
    "prepublishOnly": "npm run build",
    "postinstall": "chmod +x dist/cli.js"
  },
  "keywords": [
    "perplexity",
    "export",
    "markdown",
    "cli",
    "conversation",
    "backup",
    "automation"
  ],
  "author": "Leonid Shevtsov <leonid@shevtsov.me>",
  "contributors": [
    "Ondřej Sedláček (https://github.com/osedlacek)",
    "Pat Kelly (https://github.com/patk1002)"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^11.0.0",
    "puppeteer": "^24.9.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/patk1002/perplexport.git"
  },
  "bugs": {
    "url": "https://github.com/patk1002/perplexport/issues"
  },
  "homepage": "https://github.com/patk1002/perplexport#readme"
}